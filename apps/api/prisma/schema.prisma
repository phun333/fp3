generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STUDENT
  PROFESSOR
}

enum ProjectStatus {
  OPEN
  IN_PROGRESS
  CLOSED
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum TeamIdeaStatus {
  OPEN
  IN_PROGRESS
  CLOSED
}

enum TeamInviteRole {
  PROFESSOR
  STUDENT
}

enum TeamInviteStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum ProjectInviteStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum ProfessorApplicationPurpose {
  PROJECT
  ARTICLE
}

enum ProfessorApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String
  role          UserRole
  department    String
  year          Int?     // Kaçıncı sınıf (1-4, sadece öğrenciler için)
  bio           String?
  avatarUrl     String?
  emailVerified Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // İlişkiler
  tags             UserTag[]
  projects         Project[]      @relation("ProjectOwner")
  memberships      ProjectMember[] @relation("ProjectMemberships")
  applications     Application[]  @relation("Applicant")
  projectInvitesIn ProjectInvite[] @relation("ProjectInviteRecipient")
  projectInvitesOut ProjectInvite[] @relation("ProjectInviteSender")
  professorApplicationsSent     ProfessorApplication[] @relation("ProfAppStudent")
  professorApplicationsReceived ProfessorApplication[] @relation("ProfAppProfessor")
  publications  Publication[]
  teamIdeas     TeamIdea[] @relation("TeamIdeaOwner")
  teamInvites   TeamInvite[] @relation("TeamIdeaInvites")

  // Kayıtlı eşleşmeler
  savedMatches    SavedMatch[] @relation("SavedMatches")
  savedByStudents SavedMatch[] @relation("SavedByStudents")

  // Better Auth ilişkileri
  sessions      Session[]
  accounts      Account[]
}

model Tag {
  id       String    @id @default(cuid())
  name     String    @unique
  category String?

  users        UserTag[]
  projects     ProjectTag[]
  publications PublicationTag[]
  teamIdeas    TeamIdeaTag[]
}

model UserTag {
  userId String
  tagId  String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  tag    Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([userId, tagId])
}

model Project {
  id             String        @id @default(cuid())
  title          String
  description    String
  status         ProjectStatus @default(OPEN)
  studentSlots   Int           @default(2)
  professorSlots Int           @default(1)
  ownerId        String
  owner          User          @relation("ProjectOwner", fields: [ownerId], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  tags         ProjectTag[]
  applications Application[]
  members      ProjectMember[]
  invites      ProjectInvite[]
}

model ProjectInvite {
  id          String              @id @default(cuid())
  projectId   String
  userId      String              // davet edilen
  inviterId   String              // daveti gönderen (proje sahibi)
  invitedRole UserRole            // STUDENT veya PROFESSOR
  status      ProjectInviteStatus @default(PENDING)
  message     String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation("ProjectInviteRecipient", fields: [userId], references: [id], onDelete: Cascade)
  inviter User    @relation("ProjectInviteSender", fields: [inviterId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
}

model ProfessorApplication {
  id          String                       @id @default(cuid())
  studentId   String
  professorId String
  purpose     ProfessorApplicationPurpose  @default(PROJECT)
  title       String
  description String
  tagIds      String                       // comma-separated tag id list (snapshot)
  message     String?
  status      ProfessorApplicationStatus   @default(PENDING)
  createdProjectId String?                 // kabul edilince oluşturulan proje
  createdAt   DateTime                     @default(now())
  updatedAt   DateTime                     @updatedAt

  student   User @relation("ProfAppStudent", fields: [studentId], references: [id], onDelete: Cascade)
  professor User @relation("ProfAppProfessor", fields: [professorId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([professorId])
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  role      UserRole // STUDENT veya PROFESSOR
  joinedAt  DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation("ProjectMemberships", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
}

model ProjectTag {
  projectId String
  tagId     String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([projectId, tagId])
}

model Publication {
  id        String   @id @default(cuid())
  title     String
  abstract  String?
  url       String?
  year      Int?
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  createdAt DateTime @default(now())

  tags PublicationTag[]
}

model PublicationTag {
  publicationId String
  tagId         String
  publication   Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  tag           Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([publicationId, tagId])
}

model Application {
  id          String            @id @default(cuid())
  status      ApplicationStatus @default(PENDING)
  message     String?
  projectId   String
  project     Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  applicantId String
  applicant   User              @relation("Applicant", fields: [applicantId], references: [id], onDelete: Cascade)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([projectId, applicantId])
}

model TeamIdea {
  id             String         @id @default(cuid())
  title          String
  description    String
  professorSlots Int            @default(1)
  studentSlots   Int            @default(3)
  status         TeamIdeaStatus @default(OPEN)
  ownerId        String
  owner          User           @relation("TeamIdeaOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  tags    TeamIdeaTag[]
  invites TeamInvite[]
}

model TeamIdeaTag {
  teamIdeaId String
  tagId      String
  teamIdea   TeamIdea @relation(fields: [teamIdeaId], references: [id], onDelete: Cascade)
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([teamIdeaId, tagId])
}

model TeamInvite {
  id           String           @id @default(cuid())
  teamIdeaId   String
  userId       String
  role         TeamInviteRole
  status       TeamInviteStatus @default(PENDING)
  handoffNote  String?
  matchScore   Int              @default(0)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  teamIdea TeamIdea @relation(fields: [teamIdeaId], references: [id], onDelete: Cascade)
  user     User     @relation("TeamIdeaInvites", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamIdeaId, userId])
}

model SavedMatch {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation("SavedMatches", fields: [userId], references: [id], onDelete: Cascade)
  professorId   String
  professor     User     @relation("SavedByStudents", fields: [professorId], references: [id], onDelete: Cascade)
  purpose       String   // "ARTICLE" | "PROJECT"
  description   String?
  matchScore    Int      @default(0)
  createdAt     DateTime @default(now())

  @@unique([userId, professorId, purpose])
}

// Better Auth tabloları
model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
}

model Account {
  id                    String    @id
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
