# Expo client tarafında doğrudan okunan değişkenler EXPO_PUBLIC_ ile başlamalı.
# Mobil cihaz "localhost" üzerinden geliştirme makinene erişemez:
# Expo dev sunucusu çalışırken Metro IP'sini otomatik kullanırız,
# yine de manuel override etmek isterseniz buraya geliştirme makinesinin IP'sini yazın.

# Örnek: EXPO_PUBLIC_API_URL=http://192.168.1.50:4000
EXPO_PUBLIC_API_URL=
