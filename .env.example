# =====================================================
# FP3 — Environment örnekleri
# =====================================================
# Detaylı kurulum için → README.md  veya  apps/api/.env.example.local
#
# Port standardı:
#   Web (Next.js):    3000
#   API (Fastify):    3001
#   AI  (FastAPI):    3002
#   Postgres:         5432
# =====================================================

# === apps/api/.env ===
DATABASE_URL="postgresql://postgres:<parola>@localhost:5432/fp3"
BETTER_AUTH_SECRET="please-change-me-to-a-long-random-string"
BETTER_AUTH_URL="http://localhost:3001"
JWT_SECRET="please-change-me-to-a-long-random-string"
AI_SERVICE_URL="http://localhost:3002"
CORS_ORIGINS="http://localhost:3000"
PORT="3001"

# === apps/web/.env.local ===
NEXT_PUBLIC_API_URL="http://localhost:3001"

# === apps/ai-service/.env ===
# DATABASE_URL aynı API ile
CORS_ORIGINS="http://localhost:3001,http://localhost:3000"
PORT=3002
