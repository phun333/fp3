{
  "name": "fp3",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "clean-ports": "lsof -ti:3000,3100,4000,4100,5001,8081 | xargs kill -9 2>/dev/null || true",
    "dev:fresh": "pnpm clean-ports && turbo run dev",
    "dev:web": "turbo run dev --filter=@fp3/web",
    "dev:api": "turbo run dev --filter=@fp3/api",
    "dev:mobile": "turbo run dev --filter=@fp3/mobile",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\""
  },
  "devDependencies": {
    "playwright": "^1.60.0",
    "prettier": "^3.4.0",
    "turbo": "^2.4.0"
  },
  "packageManager": "pnpm@9.15.4",
  "overrides": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0"
  }
}
