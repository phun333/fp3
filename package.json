{
  "name": "fp3",
  "private": true,

  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@fp3/web",
    "dev:api": "turbo run dev --filter=@fp3/api",
    "dev:mobile": "turbo run dev --filter=@fp3/mobile",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\""
  },
  "devDependencies": {
    "turbo": "^2.4.0",
    "prettier": "^3.4.0"
  },
  "packageManager": "pnpm@9.15.0"
}
